{
  "name": "eclat",
  "version": "0.1.0",
  "description": "Control and screen-sync application for Nanoleaf light panels on Linux",
  "main": "dist/main/main/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "nanoleaf",
    "linux",
    "electron",
    "ambilight",
    "screen-sync",
    "wayland",
    "led",
    "smart-home"
  ],
  "author": "myqzurdux3",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "dns-packet": "^5.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myqzurdux3/eclat.git"
  },
  "bugs": {
    "url": "https://github.com/myqzurdux3/eclat/issues"
  },
  "homepage": "https://github.com/myqzurdux3/eclat#readme",
  "productName": "\u00c9clat",
  "desktopName": "eclat.desktop"
}
